#!/usr/bin/env sh
# Pre-commit: autofix → lint → short tests + coverage ≥ 70% on ./internal/...
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)
MIN_COVERAGE="${MIN_COVERAGE:-70}"
COVERAGE_PKG="${COVERAGE_PKG:-./internal/...}"

echo "==> Autofix: goimports-reviser"
if ! command -v goimports-reviser >/dev/null 2>&1; then
	echo "goimports-reviser not found. Run: make tools" >&2
	exit 1
fi
goimports-reviser -format -recursive .

echo "==> Autofix: golangci-lint"
if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "golangci-lint not found. Run: make tools" >&2
	exit 1
fi
golangci-lint fmt ./... 2>/dev/null || true
golangci-lint run --fix ./... || true

echo "==> Lint"
golangci-lint run ./...

echo "==> Test + coverage (${COVERAGE_PKG}, min ${MIN_COVERAGE}%)"
go test -short "${COVERAGE_PKG}" \
	-coverprofile=coverage.out -covermode=atomic -count=1
go tool cover -func=coverage.out
go run ./scripts/check-coverage.go coverage.out "${MIN_COVERAGE}"

# Re-stage files that were already staged (autofix may have rewritten them)
if [ -n "$STAGED_FILES" ]; then
	echo "$STAGED_FILES" | while IFS= read -r f; do
		if [ -n "$f" ] && [ -e "$f" ]; then
			git add -- "$f"
		fi
	done
fi

echo "Pre-commit checks passed."
